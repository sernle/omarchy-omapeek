# Maintainer: sonlc
pkgname=omarchy-omapeek
pkgver=0.1.0
pkgrel=1
pkgdesc="macOS-style Quick Look overlay with offline malicious-file safety checks for Omarchy Quattro"
arch=('x86_64' 'aarch64')
url="https://github.com/sonlc/omarchy-omapeek"
license=('MIT')
depends=()
optdepends=(
  'poppler: PDF page-1 thumbnail rendering (pdftoppm)'
  'ffmpeg: Audio/video codec and duration metadata (ffprobe)'
  'wl-clipboard: Preview clipboard paths via hotkey'
)
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver/inspector-rs"
  cargo build --release
}

check() {
  cd "$srcdir/$pkgname-$pkgver/inspector-rs"
  cargo test --release
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  local plugindir="$pkgdir/usr/share/omarchy/plugins/sonlc.omapeek"

  install -dm755 "$plugindir/bin" "$plugindir/rules" "$pkgdir/usr/bin"
  install -Dm644 manifest.json "$plugindir/manifest.json"
  install -Dm644 Overlay.qml "$plugindir/Overlay.qml"
  install -Dm644 BarWidget.qml "$plugindir/BarWidget.qml"
  install -Dm644 rules/community.rules "$plugindir/rules/community.rules"
  install -Dm755 bin/omapeek "$plugindir/bin/omapeek"
  install -Dm755 bin/omapeek-inspect.py "$plugindir/bin/omapeek-inspect.py"
  install -Dm755 inspector-rs/target/release/omapeek-inspect "$plugindir/bin/omapeek-inspect"

  ln -sf /usr/share/omarchy/plugins/sonlc.omapeek/bin/omapeek "$pkgdir/usr/bin/omapeek"
  ln -sf /usr/share/omarchy/plugins/sonlc.omapeek/bin/omapeek-inspect "$pkgdir/usr/bin/omapeek-inspect"
}
